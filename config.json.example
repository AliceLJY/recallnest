{
  "dbPath": "~/.recallnest/data/lancedb",
  "recallMode": "summary",
  "embedding": {
    "provider": "jina",
    "apiKey": "${JINA_API_KEY}",
    "model": "jina-embeddings-v5-text-small",
    "baseURL": "https://api.jina.ai/v1",
    "dimensions": 1024,
    "taskQuery": "retrieval.query",
    "taskPassage": "retrieval.passage"
  },
  "sources": {
    "cc": {
      "path": "auto",
      "glob": "*.jsonl",
      "description": "Claude Code transcripts"
    },
    "codex": {
      "path": "~/.codex/sessions",
      "glob": "*.jsonl",
      "description": "Codex sessions"
    },
    "memory": {
      "path": "auto",
      "glob": "*.md",
      "description": "Claude Code memory files"
    },
    "minis": {
      "path": "~/Desktop/minis-outbox/ingest",
      "glob": "*.jsonl",
      "description": "Minis (iPhone) conversations, dropped here by the agent itself"
    }
  },
  "retrieval": {
    "mode": "vector",
    "vectorWeight": 0.7,
    "bm25Weight": 0.3,
    "recencyHalfLifeDays": 30,
    "timeDecayHalfLifeDays": 120,
    "_comment_hardMinScore": "hardMinScore is only the floor for categories NOT in categoryMinScores. The built-in categoryMinScores covers all six categories (profile/preferences 0.25, entities 0.30, events 0.35, cases 0.40, patterns 0.45), so this 0.3 only reaches legacy categories (preference, fact, decision, entity, other). To change the floor for one of the six, set retrieval.categoryMinScores - it replaces the built-in map as a whole (list every category you want kept, or the rest drop to hardMinScore), and the writing / debug / fact-check profiles override it with their own scaled map.",
    "hardMinScore": 0.3
  },
  "scopeRelations": {
    "project:example-a": [
      "project:example-b"
    ]
  }
}
